# SignalSpeak caregiver settings.
#   Desktop app:  save a filled-in copy as  %APPDATA%\SignalSpeak\config.env  — it is encrypted and
#                 removed the next time the app starts.
#   Development:  save it as .env.local in this folder (git-ignored — never commit it).

# Push notifications: the caregiver installs the free "ntfy" app and subscribes to this topic.
# The topic works like a password — make it long and random (20+ letters/digits), e.g. signalspeak-<random>.
NTFY_TOPIC=

# Phone call + text message (Twilio). Trial accounts play a sample message and cannot send custom texts.
CAREGIVER_PHONE=+1XXXXXXXXXX
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Desktop app only: start SignalSpeak when the user signs in to Windows.
AUTO_START=false

# Emergency escalation — what happens after an emergency starts. Leave blank for the defaults shown.
# (Set here by the caregiver so the user can't change safety settings by an accidental glance.)
# Phone-call the caregiver when the emergency starts (true/false). Default: true
ESCALATION_CALL_CAREGIVER=
# Text the caregiver when escalating (true/false). Default: true
ESCALATION_TEXT=
# When the (simulated) 911 call happens: after-no-response | immediately. Default: after-no-response
ESCALATION_911=
# Escalate after this many seconds without a response (5–300). Default: 30
ESCALATION_WAIT_SECONDS=
# ...or this soon if the phone call clearly wasn't answered (0–300, ≤ the wait). Default: 10
ESCALATION_MIN_WAIT_SECONDS=
# Does answering the phone stop the countdown? auto | always | never. Default: auto
#   auto   = only on lines with voicemail detection (paid Twilio); trial lines need the ntfy "I'm on my way" tap
#   always = any connected call counts (on a trial line, voicemail would count too)
#   never  = only the "I'm on my way" tap counts
ESCALATION_CALL_ANSWER_COUNTS=
